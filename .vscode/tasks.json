{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build hlo-opt",
            "type": "shell",
            "command": "bazel",
            "args": [
                "build",
                "-c", "opt",
                "//xla/tools:hlo-opt"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": "$gcc",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": true,
                "clear": false
            }
        }
    ]
}