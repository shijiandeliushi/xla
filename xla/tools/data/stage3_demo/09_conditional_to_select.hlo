HloModule demo

// ConditionalToSelect:
// 将 Map 内的 kConditional(常量分支) 转换为 kSelect
// 控制流(if/else) → 数据流(select)
if_computation {
  p = () parameter(0)
  ROOT c = f32[] constant(0)
}

else_computation {
  p = () parameter(0)
  ROOT c = f32[] constant(1)
}

// Map 回调: 对每对元素执行 conditional
mapped_computation {
  a = f32[] parameter(0)
  b = f32[] parameter(1)
  lt = pred[] compare(a, b), direction=LT
  t = () tuple()
  ROOT cond = f32[] conditional(lt, t, t), true_computation=if_computation, false_computation=else_computation
}

ENTRY main {
  p1 = f32[1000] parameter(0)
  p2 = f32[1000] parameter(1)
  ROOT m = f32[1000] map(p1, p2), dimensions={0}, to_apply=mapped_computation
}
