HloModule demo

// StochasticConvertDecomposer:
// 将随机舍入类型转换 f32→s32 展开为:
// sign + abs + floor + compare(random) + select + negate + add
// 即: 用随机数与小数部分比较决定向上还是向下取整
// stochastic-convert 接受 2 个操作数: (value, random)
ENTRY main {
  p0 = f32[4] parameter(0)
  p1 = u32[4] parameter(1)
  ROOT sc = s32[4] stochastic-convert(p0, p1)
}
