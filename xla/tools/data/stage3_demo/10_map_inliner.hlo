HloModule demo

// MapInliner:
// 将 map(X, Y, fn) 内联为 fn(X, Y)
// 当 fn 是简单的一元/二元操作时消除 map 包装
max_fn {
  x = f32[] parameter(0)
  y = f32[] parameter(1)
  ROOT max = f32[] maximum(x, y)
}

ENTRY main {
  p0 = f32[100] parameter(0)
  p1 = f32[100] parameter(1)
  ROOT m = f32[100] map(p0, p1), dimensions={0}, to_apply=max_fn
}
