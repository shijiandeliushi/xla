// ============================================================================
// HLO (High Level Optimizer) IR 分析文档
// 模块: jit_my_neural_net
// 功能: 神经网络层的前向传播计算
// 输入参数:
//   - 参数0: f32[10,32]{1,0}  - 输入特征矩阵 (batch_size=10, input_features=32)
//   - 参数1: f32[32,64]{1,0}  - 权重矩阵 (input_features=32, output_features=64)
//   - 参数2: f32[64]{0}       - 偏置向量 (output_features=64)
// 输出: f32[10,64]{1,0} - 神经网络层输出 (batch_size=10, output_features=64)
// ============================================================================

HloModule jit_my_neural_net, 
  // entry_computation_layout: 定义了入口计算的参数和返回值的布局
  // (f32[10,32]{1,0}, f32[32,64]{1,0}, f32[64]{0})->f32[10,64]{1,0}
  //   - 接收3个参数: 输入矩阵、权重矩阵、偏置向量
  //   - 返回1个结果: 神经网络层的输出
  // allow_spmd_sharding_propagation_to_output=true: 允许SPMD(单程序多数据)分片传播到输出
  entry_computation_layout={(f32[10,32]{1,0}, f32[32,64]{1,0}, f32[64]{0})->f32[10,64]{1,0}}, 
  allow_spmd_sharding_propagation_to_output={true}

ENTRY main.13 {
  // =========================================================================
  // 第一步: 读取三个输入参数
  // =========================================================================
  
  // Arg_0.1: 输入特征矩阵
  // f32[10,32]{1,0}: 32位浮点数，形状[10,32]，布局{1,0}表示行优先存储
  // sharding={replicated}: 数据复制分片策略(所有计算设备都有完整副本)
  Arg_0.1 = f32[10,32]{1,0} parameter(0), sharding={replicated}
  
  // Arg_1.2: 权重矩阵
  // f32[32,64]{1,0}: 32位浮点数，形状[32,64]
  // sharding={replicated}: 数据复制分片策略
  Arg_1.2 = f32[32,64]{1,0} parameter(1), sharding={replicated}
  
  // =========================================================================
  // 第二步: 矩阵乘法 (GEMM - General Matrix Multiplication)
  // 计算: output = input @ weight.T
  // =========================================================================
  
  // dot.6: 矩阵点积运算
  // 操作: Arg_0.1 [10,32] 与 Arg_1.2 [32,64] 的点积
  // lhs_contracting_dims={1}: 左操作数收缩维度为1(形状32维)
  // rhs_contracting_dims={0}: 右操作数收缩维度为0(形状32维)
  // 即: [10,32] @ [32,64] -> [10,64]
  // 这对应于深度学习中的全连接层权重乘法
  // metadata: 记录操作的原始Python代码位置和操作名称
  // 源文件: generate_hlo.py, 第10行
  dot.6 = f32[10,64]{1,0} dot(Arg_0.1, Arg_1.2), 
    lhs_contracting_dims={1}, 
    rhs_contracting_dims={0}, 
    metadata={op_name="jit(my_neural_net)/jit(main)/dot_general[dimension_numbers=(((1,), (0,)), ((), ())) precision=None preferred_element_type=float32]" 
              source_file="/home/xianghonghui/xla/产生hlo代码/generate_hlo.py" 
              source_line=10}
  
  // =========================================================================
  // 第三步: 读取偏置向量
  // =========================================================================
  
  // Arg_2.3: 偏置向量
  // f32[64]{0}: 32位浮点数，形状[64]，布局{0}
  // sharding={replicated}: 数据复制分片策略
  Arg_2.3 = f32[64]{0} parameter(2), sharding={replicated}
  
  // =========================================================================
  // 第四步: 偏置广播的复杂变换过程
  // 目的: 将偏置向量 [64] 广播到 [10,64] 以加到点积结果上
  // 注: 这个过程包含多个中间步骤，可能不是最优的
  // =========================================================================
  
  // reshape.7: 重塑操作1
  // 输入: Arg_2.3 [64] -> 输出: [1,64]
  // 目的: 将1D向量转换为2D矩阵，为广播做准备
  // 布局{1,0}: 行优先存储
  reshape.7 = f32[1,64]{1,0} reshape(Arg_2.3), 
    metadata={op_name="jit(my_neural_net)/jit(main)/broadcast_in_dim[shape=(1, 64) broadcast_dimensions=(1,)]" 
              source_file="/home/xianghonghui/xla/产生hlo代码/generate_hlo.py" 
              source_line=12}
  
  // broadcast.8: 广播操作1
  // 输入: reshape.7 [1,64] -> 输出: [1,64]
  // dimensions={0,1}: 在维度0和1上执行广播
  // 注: 这个广播操作看起来是冗余的(形状未变)，可能在优化中被消除
  broadcast.8 = f32[1,64]{1,0} broadcast(reshape.7), 
    dimensions={0,1}, 
    metadata={op_name="jit(my_neural_net)/jit(main)/add" 
              source_file="/home/xianghonghui/xla/产生hlo代码/generate_hlo.py" 
              source_line=12}
  
  // reshape.9: 重塑操作2
  // 输入: broadcast.8 [1,64] -> 输出: [64]
  // 目的: 将2D张量降维回1D向量
  // 注: 这样的反复重塑可能在后续优化中被消除
  reshape.9 = f32[64]{0} reshape(broadcast.8), 
    metadata={op_name="jit(my_neural_net)/jit(main)/add" 
              source_file="/home/xianghonghui/xla/产生hlo代码/generate_hlo.py" 
              source_line=12}
  
  // broadcast.10: 广播操作2
  // 输入: reshape.9 [64] -> 输出: [10,64]
  // dimensions={1}: 在维度1上广播，维度0会自动扩展
  // 这是最关键的广播: [64] -> [10,64]
  // 操作: 偏置向量被复制10次(batch_size)，得到[10,64]的矩阵
  broadcast.10 = f32[10,64]{1,0} broadcast(reshape.9), 
    dimensions={1}, 
    metadata={op_name="jit(my_neural_net)/jit(main)/add" 
              source_file="/home/xianghonghui/xla/产生hlo代码/generate_hlo.py" 
              source_line=12}
  
  // =========================================================================
  // 第五步: 加法操作 - 应用偏置
  // 计算: output = matmul_result + bias
  // =========================================================================
  
  // add.11: 加法操作
  // 操作: dot.6 [10,64] + broadcast.10 [10,64] -> [10,64]
  // 这对应于全连接层的偏置加法: y = Wx + b
  // 结果: 应用了偏置的矩阵乘法结果
  add.11 = f32[10,64]{1,0} add(dot.6, broadcast.10), 
    metadata={op_name="jit(my_neural_net)/jit(main)/add" 
              source_file="/home/xianghonghui/xla/产生hlo代码/generate_hlo.py" 
              source_line=12}
  
  // =========================================================================
  // 第六步: 激活函数 - ReLU (Rectified Linear Unit)
  // 计算: output = max(0, add.11)
  // 目的: 引入非线性，增强神经网络的表达能力
  // =========================================================================
  
  // constant.4: 创建标量常量0
  // f32[]: 标量浮点数类型
  // 值: 0
  // 用途: 作为ReLU激活函数的阈值
  constant.4 = f32[] constant(0)
  
  // broadcast.5: 广播常量
  // 输入: constant.4 [] -> 输出: [10,64]
  // dimensions={}: 从标量(0维)广播到[10,64]
  // 操作: 创建一个全0矩阵，形状[10,64]
  broadcast.5 = f32[10,64]{1,0} broadcast(constant.4), 
    dimensions={}, 
    metadata={op_name="jit(my_neural_net)/jit(main)/max" 
              source_file="/home/xianghonghui/xla/产生hlo代码/generate_hlo.py" 
              source_line=14}
  
  // =========================================================================
  // 第七步: 最大值操作 - ReLU实现
  // =========================================================================
  
  // ROOT maximum.12: 最终输出结果
  // ROOT: 标记为计算的根节点/返回值
  // 操作: maximum(add.11 [10,64], broadcast.5 [10,64]) -> [10,64]
  // 语义: 逐元素选择较大值
  // 效果: 将所有负值变为0，保留正值
  // 公式: ReLU(x) = max(0, x)
  // 这是ReLU激活函数的定义
  ROOT maximum.12 = f32[10,64]{1,0} maximum(add.11, broadcast.5), 
    metadata={op_name="jit(my_neural_net)/jit(main)/max" 
              source_file="/home/xianghonghui/xla/产生hlo代码/generate_hlo.py" 
              source_line=14}
  
} // main.13 - 计算结束


// ============================================================================
// 总体流程总结
// ============================================================================
// 
// 这个HLO模块实现了一个标准的全连接神经网络层，包含以下步骤:
//
// 1. 输入读取:
//    - Input (batch_size=10, input_dim=32)
//    - Weight (input_dim=32, output_dim=64)
//    - Bias (output_dim=64)
//
// 2. 矩阵乘法:
//    output = Input @ Weight  -> [10, 64]
//
// 3. 偏置加法:
//    output = output + Bias  -> [10, 64]
//
// 4. ReLU激活:
//    output = max(0, output)  -> [10, 64]
//
// 5. 返回结果
//
// 数学表达式: output = ReLU(Input @ Weight + Bias)
//
// 性能注意事项:
// - 使用replicated分片策略，适合单机或小规模分布式训练
// - 偏置广播过程有冗余的reshape操作，应该在优化阶段被消除
// - 最终生成的机器代码应该进行内存布局和循环优化
//
// ============================================================================
